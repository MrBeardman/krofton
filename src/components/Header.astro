---
import { company, u } from '../data/site';
import Icon from './Icon.astro';

const nav = [
  { href: u('#sluzby'), label: 'Služby' },
  { href: u('#realizace'), label: 'Realizace' },
  { href: u('#jak-pracujeme'), label: 'Jak pracujeme' },
  { href: u('#otazky'), label: 'Otázky' },
  { href: u('#kontakt'), label: 'Kontakt' },
];
---

<header class="kr-header" data-header>
  <div class="kr-wrap kr-header__in">
    <a class="kr-header__logo" href={u()} aria-label="KROFTON s.r.o., na úvod stránky">
      <img src={u('logo-krofton.png')} width="208" height="33" alt="KROFTON s.r.o." />
    </a>
    <nav class="kr-header__nav" aria-label="Hlavní navigace">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="kr-btn kr-btn--signal kr-header__call" href={company.phoneHref}>
      <Icon name="phone" />
      <span>{company.phone.replace(/ /g, ' ')}</span>
    </a>
    <button class="kr-header__burger" type="button" aria-expanded="false" aria-controls="kr-drawer" data-menu-toggle>
      <span class="kr-sr">Menu</span>
      <span class="kr-header__bars" aria-hidden="true">
        <i></i>
        <i></i>
      </span>
    </button>
  </div>
  <div class="kr-drawer" id="kr-drawer" data-drawer>
    <nav class="kr-wrap" aria-label="Mobilní navigace">
      <ul>
        {nav.map((n) => (
          <li>
            <a href={n.href}>{n.label}</a>
          </li>
        ))}
      </ul>
      <a class="kr-btn kr-btn--signal kr-drawer__call" href={company.phoneHref}>
        <Icon name="phone" />
        <span>Zavolat {company.phone.replace(/ /g, ' ')}</span>
      </a>
      <p class="kr-drawer__mail">
        <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>
    </nav>
  </div>
</header>

<style is:global>
  .kr-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--les);
    color: var(--bila);
    border-bottom: 1px solid rgba(177, 237, 162, 0.16);
  }
  .kr-header__in {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--header-h);
  }
  .kr-header__logo {
    flex: none;
    display: block;
    padding: 6px 0;
  }
  .kr-header__logo img {
    width: 176px;
    height: auto;
  }
  .kr-header__nav {
    margin-left: auto;
  }
  .kr-header__nav ul {
    display: flex;
    gap: 6px;
  }
  .kr-header__nav a {
    display: block;
    padding: 10px 12px;
    color: var(--mech);
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    transition: color 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .kr-header__nav a:hover {
      color: var(--bila);
    }
  }
  .kr-header__call {
    min-height: 44px;
    padding: 8px 18px;
  }
  .kr-header__burger {
    display: none;
    margin-left: auto;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--line-dark);
    border-radius: 4px;
    background: transparent;
    color: var(--bila);
    cursor: pointer;
  }
  .kr-header__bars {
    position: relative;
    display: block;
    width: 22px;
    height: 12px;
    margin: auto;
  }
  .kr-header__bars i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 240ms var(--ease-out);
  }
  .kr-header__bars i:first-child {
    top: 0;
  }
  .kr-header__bars i:last-child {
    bottom: 0;
  }
  .menu-open .kr-header__bars i:first-child {
    transform: translateY(5px) rotate(45deg);
  }
  .menu-open .kr-header__bars i:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }

  .kr-drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--les);
    border-bottom: 1px solid var(--line-dark);
    padding: 8px 0 28px;
    opacity: 0;
    translate: 0 -8px;
    visibility: hidden;
    transition:
      opacity 200ms var(--ease-out),
      translate 240ms var(--ease-out),
      visibility 0s linear 240ms;
  }
  .menu-open .kr-drawer {
    opacity: 1;
    translate: 0 0;
    visibility: visible;
    transition:
      opacity 200ms var(--ease-out),
      translate 240ms var(--ease-out),
      visibility 0s;
  }
  .kr-drawer ul a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-dark);
    color: var(--bila);
    font: 600 1.625rem/1.1 var(--font-cond);
    text-decoration: none;
  }
  .kr-drawer__call {
    margin-top: 24px;
    width: 100%;
    justify-content: center;
  }
  .kr-drawer__mail {
    margin-top: 16px;
    text-align: center;
  }
  .kr-drawer__mail a {
    display: inline-block;
    padding: 8px;
    color: var(--mech);
  }

  @media (max-width: 1080px) {
    .kr-header__nav {
      display: none;
    }
    .kr-header__call {
      margin-left: auto;
    }
    .kr-header__burger {
      display: block;
      margin-left: 0;
    }
  }
  @media (min-width: 1081px) {
    .kr-drawer {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .kr-header__call span {
      display: none;
    }
    .kr-header__call {
      width: 48px;
      padding: 0;
      justify-content: center;
    }
    .kr-header__logo img {
      width: 150px;
    }
  }
</style>

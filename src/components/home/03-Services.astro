---
import ServiceArt from './ServiceArt.astro';
import Icon from '../Icon.astro';
import { company, services, nb } from '../../data/site';
---

<section class="kr-services" id="sluzby" aria-labelledby="kr-services-h">
  <div class="kr-wrap">
    <header class="kr-services__head">
      <h2 id="kr-services-h" data-reveal>
        Co pro vás postavíme
      </h2>
      <div class="kr-services__intro" data-reveal style="--d:1">
        <p class="kr-lead">
          {nb(
            'Od zateplení panelového domu po obklad koupelny. Ve firmě pracují zedníci, obkladači, sádrokartonáři, malíři, klempíři, stavební truhláři, natěrači, lakýrníci i stavební dělníci, takže většinu zakázek zvládneme sami a pod jednou koordinací.',
          )}
        </p>
      </div>
    </header>

    <ol class="kr-services__list">
      {services.map((s) => (
        <li class="kr-svc" id={s.id} data-art>
          <div class="kr-svc__art">
            <ServiceArt id={s.id} />
          </div>
          <div class="kr-svc__name" data-reveal style="--d:1">
            <h3>{nb(s.title)}</h3>
            <p class="kr-svc__for">{nb(s.forWhom)}</p>
          </div>
          <div class="kr-svc__body">
            <p data-reveal style="--d:2">
              {nb(s.text)}
            </p>
            <ul class="kr-svc__inc" aria-label={`Součástí služby ${s.title}`}>
              {s.includes.map((x, i) => (
                <li data-reveal style={`--d:${3 + i}`}>
                  {nb(x)}
                </li>
              ))}
            </ul>
            {s.projects && (
              <p class="kr-svc__more" data-reveal style="--d:7">
                <a href="#realizace" data-tab-link={s.projects}>
                  Ukázky realizací
                </a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="kr-services__call" data-reveal>
      <p>{nb('Nevíte, kam vaše zakázka patří? Popište ji po telefonu, poradíme.')}</p>
      <a class="kr-btn kr-btn--signal" href={company.phoneHref}>
        <Icon name="phone" />
        {company.phone.replace(/ /g, ' ')}
      </a>
    </div>
  </div>
</section>

<style is:global>
  .kr-services {
    background: var(--les);
    color: var(--bila);
    padding: var(--section) 0;
  }
  .kr-services__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(40px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .kr-services__intro .kr-lead {
    color: #dfe9d6;
  }

  .kr-svc {
    display: grid;
    grid-template-columns: 120px minmax(0, 4fr) minmax(0, 7fr);
    gap: 24px clamp(28px, 4vw, 64px);
    padding: clamp(32px, 4vw, 48px) 0;
    border-top: 1px solid var(--line-dark);
    scroll-margin-top: var(--header-h);
  }
  .kr-svc:last-child {
    border-bottom: 1px solid var(--line-dark);
  }
  .kr-svc__art .kr-art {
    width: 120px;
    height: 120px;
  }
  .kr-svc h3 {
    color: var(--bila);
  }
  .kr-svc__for {
    margin-top: 10px;
    color: var(--mech);
    font-size: 1rem;
  }
  .kr-svc__body > p:first-child {
    color: #e4ecdc;
    max-width: 38em;
  }
  .kr-svc__inc {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 28px;
    margin-top: 22px;
  }
  .kr-svc__inc li {
    position: relative;
    padding-left: 20px;
    color: #dfe9d6;
    font-size: 0.9875rem;
    line-height: 1.45;
  }
  .kr-svc__inc li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 7px;
    height: 7px;
    background: var(--signal);
    border-radius: 1px;
  }
  .kr-svc__more {
    margin-top: 22px;
  }
  .kr-svc__more a {
    display: inline-block;
    padding: 6px 0;
    color: var(--signal);
    font-weight: 600;
    text-underline-offset: 5px;
    text-decoration-thickness: 1.5px;
  }
  .kr-services__call {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: clamp(40px, 5vw, 64px);
    font: 600 clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem) / 1.2 var(--font-cond);
  }

  /* ---- line art ---- */
  .kr-art .kr-m {
    stroke: var(--mech);
  }
  .kr-art .kr-s {
    stroke: var(--signal);
  }
  .kr-art__band {
    fill: rgba(240, 255, 0, 0.14);
    stroke: none;
  }
  .kr-art__tile {
    fill: var(--signal);
    stroke: none;
    opacity: 0;
  }
  .kr-art__trowel,
  .kr-art__roller {
    animation: kr-up-down 3.6s var(--ease-in-out) infinite alternate;
  }
  .kr-art__brick {
    animation: kr-brick 4.4s var(--ease-out) infinite;
  }
  .kr-art__hook {
    transform-origin: 70px 20px;
    transform-box: view-box;
    animation: kr-sway 3.2s ease-in-out infinite alternate;
  }
  .kr-art__bubble {
    animation: kr-bubble 4.8s var(--ease-out) infinite;
  }
  .kr-art__tile {
    animation: kr-tile 6s var(--ease-out) infinite;
    animation-delay: calc(var(--n) * 260ms);
  }
  @keyframes kr-up-down {
    from {
      transform: translateY(-16px);
    }
    to {
      transform: translateY(16px);
    }
  }
  @keyframes kr-brick {
    0% {
      transform: translateX(46px);
      opacity: 0;
    }
    30%,
    80% {
      transform: translateX(0);
      opacity: 1;
    }
    100% {
      transform: translateX(0);
      opacity: 0;
    }
  }
  @keyframes kr-sway {
    from {
      transform: rotate(-5deg);
    }
    to {
      transform: rotate(5deg);
    }
  }
  @keyframes kr-bubble {
    0% {
      transform: translateX(-9px);
    }
    40% {
      transform: translateX(6px);
    }
    65% {
      transform: translateX(-2px);
    }
    80%,
    100% {
      transform: translateX(0);
    }
  }
  @keyframes kr-tile {
    0% {
      opacity: 0;
    }
    8%,
    70% {
      opacity: 0.8;
    }
    85%,
    100% {
      opacity: 0;
    }
  }
  /* loops start once the row has revealed, so nothing moves before it is drawn */
  .js .kr-svc:not(.is-in) .kr-art__loop {
    animation-play-state: paused;
  }

  @media (max-width: 999px) {
    .kr-services__head {
      grid-template-columns: 1fr;
    }
    .kr-svc {
      grid-template-columns: 96px minmax(0, 1fr);
    }
    .kr-svc__art .kr-art {
      width: 96px;
      height: 96px;
    }
    .kr-svc__body {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .kr-svc {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 18px 20px;
    }
    .kr-svc__art .kr-art {
      width: 72px;
      height: 72px;
    }
    .kr-svc__inc {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kr-art__tile {
      opacity: 0.8;
    }
    .kr-art__brick {
      opacity: 1;
    }
  }
</style>

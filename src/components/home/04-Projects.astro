---
import Photo from '../Photo.astro';
import Compare from './Compare.astro';
import { projectGroups, nb } from '../../data/site';
---

<section class="kr-projects kr-light" id="realizace" aria-labelledby="kr-projects-h">
  <div class="kr-wrap">
    <header class="kr-projects__head">
      <h2 id="kr-projects-h" data-reveal>
        Realizace
      </h2>
      <p class="kr-lead" data-reveal style="--d:1">
        {nb(
          'Bytové domy, školy, rodinné domy a koupelny, které jsme postavili, zateplili nebo opravili. Vyberte typ práce.',
        )}
      </p>
    </header>

    <Compare />

    <div class="kr-tabs" data-tabs>
      <div class="kr-tabs__list" role="tablist" aria-label="Typ realizace">
        {projectGroups.map((g, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${g.id}`}
            aria-controls={`panel-${g.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={g.id}
          >
            {g.label}
            <span class="kr-tabs__count">{g.projects.length}</span>
          </button>
        ))}
      </div>
      <div class="kr-tabs__panels">
        {projectGroups.map((g, i) => (
          <div
            class="kr-tabs__panel"
            role="tabpanel"
            id={`panel-${g.id}`}
            aria-labelledby={`tab-${g.id}`}
            data-panel={g.id}
            hidden={i !== 0}
          >
            <p class="kr-tabs__intro">{nb(g.intro)}</p>
            <ul class="kr-cards">
              {g.projects.map((p) => (
                <li class="kr-card">
                  <div class="kr-card__img">
                    <Photo
                      name={p.photo as never}
                      alt={p.alt}
                      sizes="(min-width: 1180px) 300px, (min-width: 480px) 48vw, 100vw"
                    />
                  </div>
                  <h3>{nb(p.title)}</h3>
                  <p>{nb(p.scope)}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  .kr-projects {
    padding: var(--section) 0;
  }
  .kr-projects__head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 20px clamp(40px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .kr-projects__head .kr-lead {
    color: var(--ink-2);
  }

  /* tabs */
  .kr-tabs {
    margin-top: clamp(56px, 7vw, 88px);
  }
  .kr-tabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  .kr-tabs__list button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 46px;
    padding: 8px 18px;
    border: 1.5px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    font: 600 1.0625rem/1 var(--font);
    cursor: pointer;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }
  .kr-tabs__list button[aria-selected='true'] {
    background: var(--les);
    border-color: var(--les);
    color: var(--bila);
  }
  @media (hover: hover) and (pointer: fine) {
    .kr-tabs__list button:hover:not([aria-selected='true']) {
      border-color: var(--zelen-ink);
    }
  }
  .kr-tabs__count {
    min-width: 24px;
    padding: 3px 6px;
    border-radius: 2px;
    background: rgba(38, 65, 10, 0.08);
    font-size: 0.8125rem;
    text-align: center;
  }
  [aria-selected='true'] .kr-tabs__count {
    background: var(--signal);
    color: var(--les);
  }
  .kr-tabs__intro {
    margin: 24px 0;
    color: var(--ink-2);
  }
  .kr-tabs__panel:not([hidden]) {
    animation: kr-fade 180ms var(--ease-out);
  }
  @keyframes kr-fade {
    from {
      opacity: 0;
    }
  }
  .kr-cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 36px 20px;
  }
  .kr-card__img {
    aspect-ratio: 4 / 3;
    background: var(--line);
    overflow: hidden;
  }
  .kr-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kr-card h3 {
    margin-top: 14px;
    font-size: 1.375rem;
  }
  .kr-card p {
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 0.9875rem;
  }

  @media (max-width: 1179px) {
    .kr-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 759px) {
    .kr-projects__head {
      grid-template-columns: 1fr;
    }
    .kr-cards {
      gap: 28px 14px;
    }
    .kr-card h3 {
      font-size: 1.1875rem;
    }
  }
  @media (max-width: 479px) {
    .kr-cards {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>

---
import { company, services, nb, u } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="kr-footer">
  <div class="kr-wrap kr-footer__grid">
    <div class="kr-footer__brand">
      <img src={u('logo-krofton.png')} width="208" height="33" alt="KROFTON s.r.o." loading="lazy" />
      <p>Stavební firma z Prahy. Fasády, rekonstrukce, novostavby a řemeslné práce.</p>
    </div>
    <div>
      <h2 class="kr-footer__h">Služby</h2>
      <ul>
        {services.map((s) => (
          <li>
            <a href={u(`#${s.id}`)}>{s.title}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="kr-footer__h">Kontakt</h2>
      <ul>
        <li>{company.name}</li>
        <li>{company.street}</li>
        <li>
          {company.zip} {company.city} – {company.district}
        </li>
        <li>
          <a href={company.phoneHref}>{company.phone}</a>
        </li>
        <li>
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </li>
      </ul>
    </div>
    <div>
      <h2 class="kr-footer__h">Firma</h2>
      <ul>
        <li>IČO {company.ico}</li>
        <li>DIČ {company.dic}</li>
        <li>{nb(company.register)}</li>
      </ul>
    </div>
  </div>
  <div class="kr-wrap kr-footer__base">
    <p>
      © {year} {company.name}
    </p>
    <p>
      <a href={u('#poptavka')}>Poslat poptávku</a>
    </p>
  </div>
</footer>

<style is:global>
  .kr-footer {
    background: var(--les);
    color: var(--mech);
    font-size: 0.9375rem;
    padding-top: clamp(56px, 7vw, 88px);
  }
  .kr-footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 40px;
  }
  .kr-footer__brand img {
    width: 176px;
    height: auto;
    margin-bottom: 18px;
  }
  .kr-footer__brand p {
    max-width: 22em;
  }
  .kr-footer__h {
    margin-bottom: 14px;
    color: var(--bila);
    font: 600 1.25rem/1.2 var(--font-cond);
  }
  .kr-footer li + li {
    margin-top: 6px;
  }
  .kr-footer a {
    color: var(--mech);
    text-decoration-color: rgba(177, 237, 162, 0.4);
    text-underline-offset: 3px;
    display: inline-block;
    padding: 4px 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .kr-footer a:hover {
      color: var(--bila);
    }
  }
  .kr-footer__base {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 56px;
    padding-top: 20px;
    padding-bottom: 28px;
    background: linear-gradient(var(--line-dark), var(--line-dark)) no-repeat var(--pad) 0 / calc(100% - 2 * var(--pad))
      1px;
  }
  @media (max-width: 900px) {
    .kr-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .kr-footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .kr-footer__base {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
